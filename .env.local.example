# Copy this file to ".env.local" (same folder) and fill in your real keys.
# agent.py loads ".env.local" specifically — a file named just ".env" will
# NOT be picked up by agent.py itself (some other tools do read ".env" too,
# so it doesn't hurt to duplicate keys into both, but .env.local is the one
# that matters for starting the assistant).

# --- Required: at least one Gemini key ---
# Multiple keys (comma separated) enable automatic rotation on rate limits.
GEMINI_API_KEYS=your_gemini_api_key_here
# GEMINI_API_KEY=your_single_gemini_api_key_here   # legacy fallback, use GEMINI_API_KEYS instead

# NOTE: if your terminal logs show "Both GOOGLE_API_KEY and GEMINI_API_KEY are
# set. Using GOOGLE_API_KEY.", that means one of these is set as a real
# Windows environment variable (System Properties > Environment Variables),
# outside of this file. The assistant now explicitly overrides ambient OS variables
# with what you set in .env.local, but keeping only valid keys is recommended.

# --- Optional: assistant identity ---
ASSISTANT_NAME=Cynthia
ASSISTANT_VOICE=Aoede
ASSISTANT_LANGUAGE=

# --- Optional: pin the Gemini Live model (Voice / Audio Stream) ---
# Google periodically retires dated preview Live models — if the assistant
# starts crashing with a WebSocket "1008 policy violation" error, update this value.
# Note: Changing this voice model does NOT affect the separate screen vision model.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# --- Optional: Gemini Vision Configuration (Screen Analysis) ---
# The vision tools run independently of the Live realtime voice model.
# GEMINI_VISION_MODEL: Primary model for screenshot understanding (default: gemini-3.5-flash-lite).
# Fast, stable, low latency (~1-2s), and supported across both new and legacy API keys.
GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# GEMINI_VISION_FALLBACK_MODEL: Backup model attempted if the primary returns 404/unsupported.
GEMINI_VISION_FALLBACK_MODEL=gemini-flash-lite-latest

# GEMINI_VISION_TIMEOUT: Maximum seconds allowed per vision API request (default: 15).
GEMINI_VISION_TIMEOUT=15

# --- Optional: which tools load on startup ---
# TOOL_MODE=core (default): fast startup, loads the everyday assistant tools.
# TOOL_MODE=full: loads all tools including Screen Vision (analyze_screen, detect_ui_element, etc.) and Workflows.
TOOL_MODE=core

# --- Optional: feature keys (only needed if you use these tools) ---
OPENWEATHER_API_KEY=
GOOGLE_SEARCH_API_KEY=
SEARCH_ENGINE_ID=
SERPAPI_API_KEY=
PLAY_STARTUP_SOUND=false
