# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so they can be ignored.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nosexy
.nosetests
.pytest_cache/
.history/
.venv/
venv/
venv311/
ENV/
env/
ENV/local/
ENV/utf8/

# Environments
.env
.env.local
.env.secret
.env.*

# IDEs and editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Project custom dynamic files
memory.json
contacts.json
uploads/
visualizations/*.png
visualizations/*.pdf
voice_data/**/*.wav
!voice_data/dev/*.wav
*.log
